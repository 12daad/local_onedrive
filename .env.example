# Fake development values only. QuarkSync reads the OS environment directly.
QUARKSYNC_WEBDAV_URL=http://127.0.0.1:5244/dav/
QUARKSYNC_WEBDAV_USERNAME=syncuser
QUARKSYNC_WEBDAV_PASSWORD=replace-me
QUARKSYNC_REMOTE_ROOT=Users\\hongbo
QUARKSYNC_ROOT=C:\\Users\\YourName\\QuarkSync
QUARKSYNC_CACHE_DIR=C:\\Users\\YourName\\AppData\\Local\\QuarkSync\\cache
QUARKSYNC_DATA_DIR=C:\\Users\\YourName\\AppData\\Local\\QuarkSync
QUARKSYNC_STATE_DB=C:\\Users\\YourName\\AppData\\Local\\QuarkSync\\state.db
QUARKSYNC_LOG_DIR=C:\\Users\\YourName\\AppData\\Local\\QuarkSync\\logs
QUARKSYNC_CACHE_MAX_GB=100
QUARKSYNC_CACHE_MIN_FREE_GB=20
QUARKSYNC_ALLOW_INSECURE_HTTP=false
QUARKSYNC_TLS_VERIFY=true
QUARKSYNC_WRITEBACK_DELAY_SECONDS=60
QUARKSYNC_SYNC_INTERVAL_SECONDS=300
QUARKSYNC_REMOTE_POLL_SECONDS=120
QUARKSYNC_HEARTBEAT_SECONDS=60
QUARKSYNC_DELETE_GRACE_SECONDS=86400
QUARKSYNC_MAX_UPLOADS=3
QUARKSYNC_MAX_DOWNLOADS=3
QUARKSYNC_MAX_BACKOFF_SECONDS=1800
QUARKSYNC_IPC_TIMEOUT_SECONDS=120
QUARKSYNC_IPC_CONNECT_TIMEOUT_SECONDS=10
# Full-cache download deadline; keep high enough for 10GB+ files on slow links.
QUARKSYNC_HYDRATION_TIMEOUT_SECONDS=86400
QUARKSYNC_DEVICE_NAME=LAPTOP-YourName
# Optional absolute path to a custom provider build.
# QUARKSYNC_PROVIDER_PATH=C:\\path\\to\\QuarkSync.Provider.exe
# Test/core development only. Production should keep this false.
QUARKSYNC_ALLOW_CORE_ONLY=false
QUARKSYNC_LOG_LEVEL=INFO
